{
  "manifest_version": 3,
  "name": "Math Lens \u2014 AI",
  "version": "1.9.0",
  "description": "Math exercise assistant using Groq with automatic model fallback on rate limits.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://api.groq.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Math Lens"
  }
}