{
  "manifest_version": 3,
  "name": "Math Lens \u2014 AI",
  "version": "1.6.0",
  "description": "Explain image-based math exercises using OrcaRouter or TokenHarbor.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://api.orcarouter.ai/*",
    "https://tokenharbor.ai/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Math Lens"
  }
}